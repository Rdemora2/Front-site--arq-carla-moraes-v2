# Integrações opcionais. Sem valores, nenhum tracker externo é carregado.
# Se o GTM estiver configurado, gerencie o GA4 dentro dele; o carregamento direto
# do GA é desativado para evitar pageviews duplicados.
# O container deve aplicar verificações de consentimento e não disparar Clarity
# ou outras tags fora da finalidade autorizada no banner.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
