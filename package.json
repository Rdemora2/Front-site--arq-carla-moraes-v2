{
  "name": "carla-moraes-arquitetura-floral",
  "version": "1.0.0",
  "private": true,
  "description": "Site institucional da Carla Moraes Arquitetura Floral.",
  "scripts": {
    "generate:social": "node scripts/generate-social-cards.mjs",
    "generate:sitemap": "node scripts/generate-sitemap-lastmod.mjs",
    "generate:seo": "npm run generate:social && npm run generate:sitemap",
    "prebuild": "npm run generate:seo",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:production": "node --test tests/production-artifacts.test.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:production"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "next": "15.5.24",
    "react": "19.1.8",
    "react-dom": "19.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.24",
    "postcss": "^8.5.6",
    "sharp": "0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  }
}
